{
  "$schema": "https://unpkg.com/@changesets/config/schema.json",
  "changelog": ["@changesets/changelog-github", { "repo": "mfeflow/mfeflow" }],
  "commit": false,
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "fixed": [
    [
      "mfeflow",
      "create-mfeflow",
      "@mfeflow/core",
      "@mfeflow/contracts",
      "@mfeflow/rsbuild",
      "@mfeflow/runtime",
      "@mfeflow/url-factory",
      "@mfeflow/theme",
      "@mfeflow/i18n",
      "@mfeflow/storage",
      "@mfeflow/analytics",
      "@mfeflow/telemetry",
      "@mfeflow/event-bus",
      "@mfeflow/route-factory",
      "@mfeflow/http",
      "@mfeflow/testing",
      "@mfeflow/tsconfig",
      "@mfeflow/oxlint-config"
    ]
  ],
  "ignore": ["@mfeflow/docs"],
  "privatePackages": { "version": false, "tag": false }
}
