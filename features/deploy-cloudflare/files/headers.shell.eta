# Files that decide what is live are checked on every load. Hashed files never change, so they are cached
# for a year. Each path matches one rule, because a header set by two rules is joined with a comma.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/mf-manifest.json
  Cache-Control: no-cache
/config/runtime-config*
  Cache-Control: no-cache
<% if (!it.options.r2Proxy) { %>/registry/*
  Cache-Control: no-cache
<% } %>/static/*
  Cache-Control: public, max-age=31536000, immutable
