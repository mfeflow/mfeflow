<% const hashed = it.bundler === 'vite' ? 'assets' : 'static' -%>
# The shell's origin is filled in from deploy/cloudflare.json when the build is staged, so the shell can load
# this remote with crossorigin. Each path matches one Cache-Control rule, because a header set by two rules is
# joined with a comma. Hashed files under /<%= hashed %> never change.
/*
  Access-Control-Allow-Origin: __SHELL_ORIGIN__
  X-Content-Type-Options: nosniff
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/mf-manifest.json
  Cache-Control: no-cache
/<%= hashed %>/*
  Cache-Control: public, max-age=31536000, immutable
