{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // A remote as its own Worker with static assets. This file is yours: change names, add routes, drop an environment.
  // Deploy with `pnpm deploy:cloudflare <staging|prod>`. Remotes have no fallback page, so a mistyped path is a
  // 404 and not an HTML page where JavaScript was expected.
  "name": "<%= it.scope.slice(1) %>-<%= it.app.name %>",
  "compatibility_date": "2026-10-28",
  "assets": { "directory": "./dist", "not_found_handling": "none" },
  // The shell loads this remote from its own address, so give each environment a route or use its workers.dev name:
  // "routes": [{ "pattern": "<%= it.app.name %>.shop.example.com", "custom_domain": true }]
  "env": {
    "staging": {
      "name": "<%= it.scope.slice(1) %>-<%= it.app.name %>-staging",
      "assets": { "directory": "./.mfeflow/cloudflare/staging", "not_found_handling": "none" },
    },
    "prod": {
      "name": "<%= it.scope.slice(1) %>-<%= it.app.name %>-prod",
      "assets": { "directory": "./.mfeflow/cloudflare/prod", "not_found_handling": "none" },
    },
  },
}
