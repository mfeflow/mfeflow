<%_ const prefix = it.app.tailwindPrefix _%>
import { clsx, type ClassValue } from 'clsx';
import { extendTailwindMerge } from 'tailwind-merge';

// Knows this remote's prefix, so cn('<%= prefix %>:p-2', '<%= prefix %>:p-4') keeps only the last one.
const merge = extendTailwindMerge({ prefix: '<%= prefix %>' });

/** Joins class names and drops the ones a later class overrides. */
export function cn(...inputs: ClassValue[]): string {
  return merge(clsx(inputs));
}
