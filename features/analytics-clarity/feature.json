{
  "name": "analytics-clarity",
  "version": "0.1.0",
  "description": "Microsoft Clarity behind @mfeflow/analytics, next to Google Tag Manager. Clarity loads only after the visitor grants analytics consent in the banner analytics-gtm adds, and stops again if they withdraw it. The project id is the runtime config's clarityId.",
  "requires": ["core", "tsconfig", "analytics-gtm"],
  "files": [
    {
      "to": "src/analytics/clarity.ts",
      "target": "shell",
      "from": "files/clarity.ts"
    },
    {
      "to": "src/analytics/clarity.test.ts",
      "target": "shell",
      "from": "files/clarity-test.ts",
      "when": {
        "feature:testing": true
      }
    }
  ],
  "transforms": [
    {
      "op": "add-boot-step",
      "file": "src/bootstrap.tsx",
      "target": "shell",
      "call": "initClarityFromConfig",
      "from": "./analytics/clarity",
      "await": false
    },
    {
      "op": "add-env-key",
      "file": "src/config/schema.ts",
      "target": "shell",
      "key": "clarityId",
      "scope": "runtime",
      "schema": {
        "zod": "z.string().regex(/^([a-z0-9]{8,12})?$/)",
        "valibot": "v.pipe(v.string(), v.regex(/^([a-z0-9]{8,12})?$/))",
        "arktype": "'/^([a-z0-9]{8,12})?$/'"
      },
      "value": "",
      "configFiles": [
        "public/config/runtime-config.dev.json",
        "public/config/runtime-config.staging.json",
        "public/config/runtime-config.prod.json"
      ],
      "when": {
        "feature:env-t3": true
      }
    },
    {
      "op": "add-env-key",
      "file": "public/config/runtime-config.json",
      "target": "shell",
      "key": "clarityId",
      "scope": "runtime",
      "schema": "z.string().regex(/^([a-z0-9]{8,12})?$/)",
      "value": "",
      "when": {
        "feature:env-t3": false
      }
    }
  ]
}
