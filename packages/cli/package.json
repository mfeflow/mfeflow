{
  "name": "mfeflow",
  "version": "0.5.0",
  "description": "Create and grow a React micro-frontend platform: mfeflow init, add remote, add <feature>.",
  "keywords": [
    "micro-frontend",
    "micro-frontends",
    "mfe",
    "module-federation",
    "module-federation-2",
    "react",
    "rsbuild",
    "rspack",
    "cli",
    "scaffolding",
    "boilerplate"
  ],
  "homepage": "https://mfeflow.github.io/mfeflow/",
  "bugs": "https://github.com/mfeflow/mfeflow/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfeflow/mfeflow.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Sanjeev Sharma <speedsharma.ai@gmail.com>",
  "type": "module",
  "bin": {
    "mfeflow": "./bin/mfeflow.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/copy-assets.mjs && rslib build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@mfeflow/contracts": "workspace:*",
    "@mfeflow/core": "workspace:*",
    "@mfeflow/registry": "workspace:*",
    "citty": "catalog:",
    "semver": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@mfeflow/rsbuild": "workspace:*",
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "typescript": "catalog:"
  }
}
