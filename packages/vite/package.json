{
  "name": "@mfeflow/vite",
  "version": "0.8.0",
  "description": "Vite presets for Module Federation 2.0 micro-frontends: createShellConfig and createRemoteConfig with shared singletons, manifests, types and error reporting set up, on @module-federation/vite.",
  "keywords": [
    "micro-frontend",
    "mfe",
    "module-federation",
    "module-federation-2",
    "vite",
    "preset",
    "react"
  ],
  "homepage": "https://mfeflow.github.io/mfeflow/",
  "bugs": "https://github.com/mfeflow/mfeflow/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfeflow/mfeflow.git",
    "directory": "packages/vite"
  },
  "license": "MIT",
  "author": "Sanjeev Sharma <speedsharma.ai@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mfeflow/bundler-shared": "workspace:*",
    "@module-federation/vite": "catalog:",
    "@vitejs/plugin-react": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@rslib/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "mfeflow": {
    "bucket": "config"
  }
}
