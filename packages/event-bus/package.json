{
  "name": "@mfeflow/event-bus",
  "version": "0.4.0",
  "description": "A typed event bus for micro-frontends on one page: versioned event names, payload types merged by each remote, optional validation, replay for late subscribers, and a React hook.",
  "keywords": [
    "micro-frontend",
    "mfe",
    "module-federation",
    "event-bus",
    "pub-sub",
    "typescript",
    "react"
  ],
  "homepage": "https://mfeflow.github.io/mfeflow/",
  "bugs": "https://github.com/mfeflow/mfeflow/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfeflow/mfeflow.git",
    "directory": "packages/event-bus"
  },
  "license": "MIT",
  "author": "Sanjeev Sharma <speedsharma.ai@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./standard-schema": {
      "types": "./dist/standard-schema.d.ts",
      "import": "./dist/standard-schema.js",
      "default": "./dist/standard-schema.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rslib build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mfeflow/contracts": "workspace:*",
    "@rsbuild/plugin-react": "catalog:",
    "@rslib/core": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:"
  },
  "mfeflow": {
    "bucket": "singleton"
  }
}
