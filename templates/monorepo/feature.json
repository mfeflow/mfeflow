  "scripts": [
    {
      "name": "dev",
      "command": "turbo run dev",
      "target": "root"
    },
    {
      "name": "build",
      "command": "turbo run build",
      "target": "root"
    },
    {
      "name": "doctor",
      "command": "mfeflow doctor",
      "target": "root"
    },
    {
      "name": "validate",
      "command": "mfeflow validate",
      "target": "root"
    },
    {
      "name": "check-compat",
      "command": "mfeflow check-compat",
      "target": "root"
    },
    {
      "name": "budget",
      "command": "mfeflow budget",
      "target": "root"
    },
    {
      "name": "dev",
      "command": "rsbuild dev",
      "target": "shell"
    },
    {
      "name": "build",
      "command": "rsbuild build",
      "target": "shell"
    },
    {
      "name": "dev",
      "command": "rsbuild dev",
