{
  "name": "<%= it.scope %>/contracts",
  "version": "0.1.0",
  "description": "Event names and types the shell and every remote agree on.",
  "type": "module",
  "files": <% if (it.options.name) { %>[
    "dist"
  ]<% } else { %>["dist"]<% } %>,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
